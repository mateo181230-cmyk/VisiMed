# Instalar como /etc/uno-visitas/backup.env, propietario root, modo 600.
# Sintaxis de shell; no poner estos secretos en Git.
UNO_BACKUP_OFFSITE=0
UNO_BACKUP_APP_DIR=/opt/uno-visitas/current
UNO_BACKUP_DIR=/opt/uno-visitas/backups
UNO_RUNTIME_ENV_FILE=/opt/uno-visitas/runtime.env
UNO_BACKUP_HOST=uno-visitas
UNO_BACKUP_LOCAL_DAYS=14
UNO_BACKUP_KEEP_DAILY=7
UNO_BACKUP_KEEP_WEEKLY=4
UNO_BACKUP_KEEP_MONTHLY=6
RESTIC_CACHE_DIR=/var/cache/uno-visitas-restic

# Configurar un destino propiedad del usuario EN OTRO SERVIDOR/cuenta y luego activar OFFSITE=1.
# Ejemplo de forma para S3 compatible (reemplazar HOST, BUCKET y PREFIX):
# RESTIC_REPOSITORY='s3:https://HOST/BUCKET/PREFIX'
# AWS_ACCESS_KEY_ID=''
# AWS_SECRET_ACCESS_KEY=''
# AWS_DEFAULT_REGION=''
# RESTIC_PASSWORD_FILE=/etc/uno-visitas/restic-password

# Otra opción: repositorio SFTP en OTRO servidor con llave dedicada y host verificado.
# RESTIC_REPOSITORY='sftp:usuario@HOST:/ruta/uno-visitas'
