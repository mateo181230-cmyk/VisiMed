# Copia este archivo a `.env` (que NO se sube al repositorio) y ajusta los valores.
# Todas las variables llevan el prefijo UNO_. Los secretos van solo aquí o en el entorno del servidor.

UNO_ENV=dev                       # dev | test | prod  (prod exige JWT secreto y cookie segura)
UNO_DATABASE_URL=sqlite+aiosqlite:///./var/uno-dev.db
# Producción: postgresql+asyncpg://usuario:clave@host:5432/uno

# --- Sesión ---
UNO_JWT_SECRET=                   # ≥ 32 caracteres aleatorios: python -c "import secrets; print(secrets.token_urlsafe(48))"
UNO_COOKIE_SECURE=false           # true en producción (HTTPS)

# --- Avisos en el teléfono (Web Push) ---
# Genera el par con:  uv run python -m uno.cli vapid-generate
UNO_PUSH_BACKEND=log              # log (desarrollo) | webpush (real) | memory (pruebas)
UNO_VAPID_PUBLIC_KEY=
UNO_VAPID_PRIVATE_KEY=            # secreto
UNO_VAPID_SUBJECT=mailto:soporte@tu-dominio.com

# --- Avisos por correo ---
UNO_EMAIL_BACKEND=file            # file (escribe .eml en UNO_MAIL_DIR) | smtp | memory
UNO_EMAIL_FROM=UNO Visitas <no-reply@tu-dominio.com>
UNO_MAIL_DIR=./var/mail
UNO_SMTP_HOST=localhost
UNO_SMTP_PORT=1025
UNO_SMTP_USER=
UNO_SMTP_PASSWORD=
UNO_SMTP_STARTTLS=false
UNO_SMTP_SSL=false

# --- Recordatorios ---
UNO_APP_BASE_URL=http://localhost:5173   # enlace «Abrir UNO Visitas» de los correos
UNO_NOTIFY_INCLUDE_NAMES=true            # false: los avisos no nombran al médico (ver Q15 del doc 01)
UNO_EMBEDDED_WORKER=false                # true solo en desarrollo: corre el trabajador dentro de la API
UNO_REMINDER_POLL_SECONDS=60

# --- Llamadas de resumen (ElevenLabs + Telyaco) ---
# Las llaves NO van aquí: van en ~/.uno-visitas/secrets.env (fuera del repositorio y de OneDrive).
UNO_CALL_BACKEND=off                     # off (nunca llama) | fake (simulado) | elevenlabs (real)
# UNO_ELEVENLABS_API_KEY=                # secreto
# UNO_ELEVENLABS_AGENT_ID=               # lo imprime `uno elevenlabs-apply`
# UNO_ELEVENLABS_PHONE_NUMBER_ID=        # número (Twilio o SIP) asignado con `uno elevenlabs-assign-number`
# UNO_ELEVENLABS_PHONE_CHANNEL=auto     # auto (se detecta) | twilio | sip_trunk
# UNO_ELEVENLABS_WEBHOOK_SECRET=         # opcional: secreto HMAC del webhook de fin de llamada
UNO_CALL_ALLOWED_PHONES=                 # fuera de producción solo se llama a estos (coma, E.164)
UNO_CALL_INCLUDE_DOCTOR_NAMES=false      # ¿el agente dice el nombre del médico? (Q15, legal)
UNO_CALL_WINDOW_START_HOUR=7             # no se llama antes de esta hora local…
UNO_CALL_WINDOW_END_HOUR=19              # …ni desde esta
UNO_CALL_CLOSING_HOUR=18                 # llamada de cierre con lo que quedó pendiente
UNO_CALL_RETRY_MINUTES=5,15              # reintentos si no contesta

# --- Entrenar: práctica con médico virtual (video de Tavus + voz de ElevenLabs) ---
# La llave NO va aquí: UNO_TAVUS_API_KEY va en ~/.uno-visitas/secrets.env.
UNO_TRAINING_BACKEND=off                 # off (sin médico; la preparación sí funciona) | fake (simulado) | tavus (real)
# UNO_TAVUS_API_KEY=                     # secreto
# UNO_TAVUS_CALLBACK_BASE_URL=           # URL pública HTTPS de esta API para el webhook de Tavus (sin ella, se consulta)
# UNO_TRAINING_TTS_API_KEY=              # solo si la voz de ElevenLabs es privada; las públicas no la necesitan
UNO_TRAINING_MAX_CALL_SECONDS=300        # duración máxima de cada visita de práctica
UNO_TRAINING_ATTEMPTS_PER_DAY=6          # prácticas por visitador y por día (control de costo)
UNO_TRAINING_POLL_SECONDS=5              # cada cuánto se consulta la transcripción
UNO_TRAINING_TRANSCRIPT_TIMEOUT_MINUTES=5   # sin transcripción tras esto, la visita queda «sin conversación»
